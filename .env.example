# Copy to .env (never commit .env). Read by `docker compose` and by the backend when you run it
# locally (application.yml imports ./.env and ../.env).

# --- Database ---------------------------------------------------------------
DB_NAME=bankdb
DB_USERNAME=bank
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
# Only used when the backend runs outside Docker (e.g. ./mvnw spring-boot:run):
DB_URL=jdbc:mysql://localhost:3306/bankdb?serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true

# --- Security ---------------------------------------------------------------
# Base64 HMAC key of at least 256 bits. Generate one with:  openssl rand -base64 48
JWT_SECRET=

# --- Optional ---------------------------------------------------------------
# How long a new payee waits before it can receive money (ISO-8601 or 30m / 2h style).
BENEFICIARY_COOLING_PERIOD=30m
# First admin for environments WITHOUT demo data (prod profile). Ignored once an admin exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
